# Volitelné serverové klíče – nastav je ve Vercelu (Project → Settings → Environment Variables).
# Pokud je nastavíš, studenti nemusí zadávat vlastní klíče v aplikaci (klíč zadaný v aplikaci má přednost).

# PID Golemio API (https://api.golemio.cz/api-keys) – odjezdové tabule, zpoždění, klimatizace
GOLEMIO_API_KEY=

# Google Maps Platform – Routes API (computeRoutes, režim TRANSIT) pro trasy s přestupy
GOOGLE_MAPS_API_KEY=

# Anthropic API – volitelné AI vylepšení parseru harmonogramu a sylabů
ANTHROPIC_API_KEY=

# Google (Kalendář, Úkoly, Disk) – OAuth Client ID typu „Web application“ (návod v README → Propojení s Googlem).
# Client ID je veřejný údaj; VITE_ verze se vloží do frontendu při buildu.
VITE_GOOGLE_CLIENT_ID=
# Volitelné trvalé přihlášení: server drží refresh token zašifrovaný v HttpOnly cookie.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Volitelný vlastní klíč pro šifrování cookie (jinak se odvodí z GOOGLE_CLIENT_SECRET).
GOOGLE_TOKEN_SECRET=

# Volitelný allowlist domén pro Moodle/iCal proxy (čárkami, podporuje zástupné *.domena.cz)
# Příklad: PROXY_ALLOWED_HOSTS=*.cuni.cz,calendar.google.com
PROXY_ALLOWED_HOSTS=

# Volitelná synchronizace stavu na vlastní backend (viz README → „Napojení na backend“)
VITE_SYNC_URL=
